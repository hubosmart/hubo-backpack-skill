(version 1)
# Basic routing rules: SPEC-005 chapter 10; process values taken from the JLCPCB "Process Parameters" (verified 2026-10-09).
# Usage: do not copy by hand - run scripts/power_rules.py, which inserts this template right after (version 1) in the project .kicad_dru
# and appends the power trace width rules at the end; local exception rules of the project go after the template.
# Written as custom rules rather than in .kicad_pro: MCP save_project overwrites the rules in .kicad_pro back to defaults (07 item 7).
# Impedance and RF traces have their own net classes for width and spacing; where a net class is stricter than this file, the net class prevails; anything below the recommended values here must be listed in the design document.

# 10.2 Trace width: recommended >= 5 mil (process minimum: 3.5 mil multilayer, 4 mil double-sided)
(rule "HZ_track_width"
	(constraint track_width (min 0.127mm)))

# Two KiCad semantics of clearance rules (measured):
#   1 When several rules of the same constraint type match, the **last** matching rule in the file wins - broad rules must be written before specific ones;
#   2 Custom rules take precedence over net classes: an unconditional clearance rule relaxes net classes (such as HDMI/MIPI 0.15, PWR 0.15) to this rule's value.
# So both clearance rules apply only to copper whose two sides are both in the Default net class; nets with a dedicated net class follow the net class clearance (the larger of the two sides),
# and the net class clearance must be >= the values in this file; if lower, list it in the design document. The global minimum is backstopped by the board setup minimum clearance.

# 10.3 Pad edge to trace edge >= 0.1 mm (also used as the lower limit between all other copper)
(rule "HZ_clearance"
	(condition "A.NetClass == 'Default' && B.NetClass == 'Default'")
	(constraint clearance (min 0.1mm)))

# 10.2 Trace spacing: between traces >= 5 mil (takes effect only when written after HZ_clearance)
(rule "HZ_track_clearance"
	(condition "A.Type == 'Track' && B.Type == 'Track' && A.NetClass == 'Default' && B.NetClass == 'Default'")
	(constraint clearance (min 0.127mm)))

# 10.4 Vias: hole >= 0.3 mm, outer diameter >= 0.4 mm and >= 0.15 mm larger than the hole (annular ring >= 0.075 mm), hole edge to hole edge >= 0.2 mm
# JLCPCB adds a surcharge for hole < 0.3 mm with outer diameter <= 0.4 mm; this template's actual lower limit is 0.3/0.45 mm (the outer diameter is derived from the annular ring constraint, consistent with the usual minimum in SPEC-005 10.4)
(rule "HZ_via"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.3mm))
	(constraint via_diameter (min 0.4mm))
	(constraint annular_width (min 0.075mm))
	(constraint hole_to_hole (min 0.2mm)))

# 10.4 Through-hole pads: annular ring >= 0.2 mm on multilayer boards (0.25 mm recommended for double-sided)
(rule "HZ_pth"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.2mm)))

# 10.4 Through-hole pad hole edge to through-hole pad hole edge >= 0.45 mm. JLCPCB only specifies through-hole pad to through-hole pad (0.45) and via to via (0.2);
# via to through-hole pad is not listed separately, so it is handled by the via rule at 0.2 mm (HZ_via), not 0.45
(rule "HZ_pth_to_pth"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Pad' && B.Pad_Type == 'Through-hole'")
	(constraint hole_to_hole (min 0.45mm)))

# 10.5 Copper to board outline >= 0.3 mm (JLCPCB routing is 0.2 mm, SPEC-003 6.4.1 uses 0.3 mm; use 0.4 mm for V-cut panels)
(rule "HZ_edge"
	(constraint edge_clearance (min 0.3mm)))

# 10.9 Silkscreen text height >= 1.0 mm, line width >= 0.15 mm
(rule "HZ_silk_text"
	(layer "?.Silkscreen")
	(constraint text_height (min 1.0mm))
	(constraint text_thickness (min 0.15mm)))
